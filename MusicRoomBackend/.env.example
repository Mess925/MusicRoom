# App
APP_NAME="Music Room API"
ENVIRONMENT=development
DEBUG=true
API_PORT=8000

# API reference (Swagger UI / ReDoc). Set DOCS_ENABLED=false to hide them.
DOCS_ENABLED=true
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Postgres (consumed by the postgres service and to build DATABASE_URL)
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=musicroom
POSTGRES_DB=musicroom
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Overridden by Docker Compose for the api service; used when running locally
DATABASE_URL=postgresql+asyncpg://musicroom:musicroom@localhost:5432/musicroom
REDIS_URL=redis://localhost:6379/0
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
